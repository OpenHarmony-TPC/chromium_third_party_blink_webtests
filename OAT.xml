            <policyitem type="compatibility" name="MPL-1.1" path=".*" desc="" />
            <policyitem type="compatibility" name="OFL-1.1-no-RFN" path=".*" desc="" />
            <policyitem type="compatibility" name="MPL-2.0" path=".*" desc="" />
