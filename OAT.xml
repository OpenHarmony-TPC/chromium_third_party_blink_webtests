                    desc="" />
                <filteritem type="filepath" name=".*README.chromium"
                    desc="" />
                <filteritem type="filepath" name="external/wpt/fonts/CSSTest/LICENSE"
                    desc="" />
                <filteritem type="filepath" name="third_party/gsubtest/LICENSE.txt"
                    desc="" />
                <filteritem type="filepath" name=".*PngSuite.LICENSE"
                    desc="" />
                <filteritem type="filepath" name="external/wpt/interfaces/encrypted-media.idl"
                    desc="" />    
                <filteritem type="filepath" name="external/wpt/css/css-align/resources/alignment-parsing-utils.js"
                    desc="" />
                <filteritem type="filepath" name="external/wpt/css/css-fonts/support/fonts/gsubtest-lookup3.ufo/fontinfo.plist"
                    desc="" />
                 <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter>
            <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter>
        </filefilterlist>
